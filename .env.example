# Copiar para .env e preencher. O Spring Boot lê este ficheiro automaticamente
# (spring.config.import em application.yml). Nunca versionar o .env.

# MySQL local
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ngolahealth
DB_USER=
DB_PASSWORD=

# Segredo dos tokens JWT (Base64, >= 256 bits). Gerar com: openssl rand -base64 32
JWT_SECRET=

# Origem do frontend (CORS)
APP_BASE_URL=http://localhost:4200

# Apenas perfil dev: senha inicial (>= 12 caracteres) dos utilizadores de demonstração
# platform-admin (SUPER_ADMIN) e admin.hcl (ADMIN do hospital HCL-001). Troca obrigatória no 1.º acesso.
DEV_ADMIN_PASSWORD=
