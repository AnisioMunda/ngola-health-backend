# Copiar para .env e preencher. O Spring Boot lê este ficheiro automaticamente
# (spring.config.import em application.yml). Nunca versionar o .env.

# MySQL local
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ngolahealth
DB_USER=
DB_PASSWORD=

# Segredo dos tokens JWT (Base64, >= 256 bits). Gerar com: openssl rand -base64 32
JWT_SECRET=

# Origem do frontend (CORS)
APP_BASE_URL=http://localhost:4200

# Apenas perfil dev: senha inicial (>= 12 caracteres) dos utilizadores de demonstração
# platform-admin (SUPER_ADMIN) e admin.hcl (ADMIN do hospital HCL-001). Troca obrigatória no 1.º acesso.
DEV_ADMIN_PASSWORD=
# true = cria uma vez o "Hospital Demo Ngola" com 30 dias de actividade (utilizadores *.demo
# com a senha de DEV_ADMIN_PASSWORD). Só no perfil dev; pode voltar a false depois.
DEMO_DATA=false

# Prometheus: credenciais HTTP Basic para /api/actuator/prometheus (senha >= 16 caracteres).
# Vazio = endpoint fechado. Gerar a senha com: openssl rand -base64 24
METRICS_USERNAME=
METRICS_PASSWORD=

# Ficheiro de log opcional (rodado a 50 MB, 30 dias). Vazio = só consola.
# No perfil prod os logs saem em JSON (formato Logstash).
LOG_FILE=

# Consultas mais lentas do que isto (ms) ficam no log (org.hibernate.SQL_SLOW), sem os valores.
SLOW_QUERY_MS=500
