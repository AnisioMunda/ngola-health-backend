<?xml version="1.0" encoding="UTF-8"?>
<!--
  Master changelog: apenas inclui os ficheiros SQL de cada módulo, por ordem de dependência.
  Convenção: changes/<modulo>/NNN-descricao.sql, em "liquibase formatted sql", um ficheiro
  consolidado por módulo. Nunca editar um changeset já aplicado; criar um novo.
-->
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Módulo 1: Hospitais -->
    <include file="changes/hospitals/001-create-hospitals.sql" relativeToChangelogFile="true"/>

    <!-- Módulo 2: Utilizadores e autenticação -->
    <include file="changes/users/001-create-users-and-sessions.sql" relativeToChangelogFile="true"/>

    <!-- Módulo 3: Auditoria -->
    <include file="changes/audit/001-create-audit-events.sql" relativeToChangelogFile="true"/>

    <!-- Módulo 4: Pacientes -->
    <include file="changes/patients/001-create-patients.sql" relativeToChangelogFile="true"/>

    <!-- Módulo 5: Episódios -->
    <include file="changes/episodes/001-create-episodes.sql" relativeToChangelogFile="true"/>

    <!-- Módulo 6: Triagem -->
    <include file="changes/triage/001-create-triage.sql" relativeToChangelogFile="true"/>

</databaseChangeLog>
