<?xml version="1.0" encoding="UTF-8"?>
<!--
  Master changelog: apenas inclui os ficheiros SQL de cada módulo, por ordem de dependência.
  Convenção: changes/<modulo>/NNN-descricao.sql, em "liquibase formatted sql", um ficheiro
  consolidado por módulo. Nunca editar um changeset já aplicado; criar um novo.
-->
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Módulo 1: Hospitais -->
    <include file="changes/hospitals/001-create-hospitals.sql" relativeToChangelogFile="true"/>

    <!-- Módulo 2: Utilizadores e autenticação -->
    <include file="changes/users/001-create-users-and-sessions.sql" relativeToChangelogFile="true"/>

    <!-- Módulo 3: Auditoria -->
    <include file="changes/audit/001-create-audit-events.sql" relativeToChangelogFile="true"/>

    <!-- Módulo 4: Pacientes -->
    <include file="changes/patients/001-create-patients.sql" relativeToChangelogFile="true"/>

    <!-- Módulo 5: Episódios -->
    <include file="changes/episodes/001-create-episodes.sql" relativeToChangelogFile="true"/>

    <!-- Módulo 6: Triagem -->
    <include file="changes/triage/001-create-triage.sql" relativeToChangelogFile="true"/>

    <!-- Módulo 7: Farmácia -->
    <include file="changes/pharmacy/001-create-pharmacy.sql" relativeToChangelogFile="true"/>

    <!-- Módulo 8: Prescrições -->
    <include file="changes/prescriptions/001-create-prescriptions.sql" relativeToChangelogFile="true"/>

    <!-- Módulo 9: Laboratório -->
    <include file="changes/laboratory/001-create-laboratory.sql" relativeToChangelogFile="true"/>

    <!-- Módulo 10: Notificações -->
    <include file="changes/notifications/001-create-notifications.sql" relativeToChangelogFile="true"/>

    <!-- Módulo 11: Agendamento -->
    <include file="changes/scheduling/001-create-scheduling.sql" relativeToChangelogFile="true"/>

    <!-- Módulo 12: Internamento -->
    <include file="changes/inpatient/001-create-inpatient.sql" relativeToChangelogFile="true"/>

    <!-- Módulo 13: Financeiro -->
    <include file="changes/financial/001-create-financial.sql" relativeToChangelogFile="true"/>
    <!-- Módulo 13 retirado: apaga as tabelas do financeiro -->
    <include file="changes/financial/002-drop-financial.sql" relativeToChangelogFile="true"/>

    <!-- Módulo 14: Recursos humanos -->
    <include file="changes/hr/001-create-hr.sql" relativeToChangelogFile="true"/>

    <!-- Módulo 15: Equipamentos -->
    <include file="changes/equipment/001-create-equipment.sql" relativeToChangelogFile="true"/>

    <!-- Módulo 17: Portal do paciente -->
    <include file="changes/portal/001-create-portal.sql" relativeToChangelogFile="true"/>

</databaseChangeLog>
